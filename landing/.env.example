# Widget "monte metade da trilha" — chama o LLM direto (sem banco).
# Sem nenhuma chave, o widget mostra um exemplo estático + CTA pro Telegram.
# Cadeia de provedores OpenAI-compat (ordem = prioridade); só entram os que têm key.
LLM_PROVIDER=gemini,groq,cerebras,sambanova,mistral,github,openrouter
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
MISTRAL_API_KEY=
GITHUB_MODELS_TOKEN=
OPENROUTER_API_KEY=
# modelo por provedor (opcional): GEMINI_MODEL, GROQ_MODEL, ...
# opcional — sobrescreve o handle do bot usado nos links
NEXT_PUBLIC_BOT=AristotelIA_bot
