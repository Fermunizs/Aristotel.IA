# Copie para .env e preencha. NUNCA commite o .env.

# Token do BotFather (t.me/AristotelIA_bot)
TELEGRAM_TOKEN=

# LLM — cadeia de provedores com fallback automático (ordem = prioridade).
# O 1º com key preenchida é o primário; se estourar rate limit, cai pro próximo.
# Todos OpenAI-compat. Só entram na cadeia os que têm key. Cada key = mais folga.
LLM_PROVIDER=gemini,groq,cerebras,sambanova,mistral,github,openrouter
GEMINI_API_KEY=          # https://aistudio.google.com/apikey  (grátis, ~1500 req/dia)
GROQ_API_KEY=            # https://console.groq.com/keys  (grátis, rápido)
CEREBRAS_API_KEY=        # https://cloud.cerebras.ai  (grátis, inferência ultrarrápida)
SAMBANOVA_API_KEY=       # https://cloud.sambanova.ai  (grátis, rápido)
MISTRAL_API_KEY=         # https://console.mistral.ai  (tier "Experiment", bom PT)
GITHUB_MODELS_TOKEN=     # PAT github com escopo models:read  (grátis, GPT-4o-mini etc.)
OPENROUTER_API_KEY=      # https://openrouter.ai/keys  (agregador, modelos :free)
LLM_MODEL=               # legado — sobrescreve o modelo só do 1º provedor
# modelo por provedor (opcional): GEMINI_MODEL, GROQ_MODEL, CEREBRAS_MODEL, ...
LLM_CONCURRENCY=2        # chamadas simultâneas por provedor (free tier: 2)

# Banco (Postgres) — bot e web usam o mesmo
DATABASE_URL=postgresql://arist:arist_local_dev@127.0.0.1:5432/aristotelia

# Painel web
WEB_URL=http://localhost:3000

# chat_id do Telegram da Fernanda — vira superadmin no /start
SUPERADMIN_CHAT_ID=

TZ=America/Sao_Paulo
