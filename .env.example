# Copie para .env e preencha. NUNCA commite o .env.

# Token do BotFather (t.me/AristotelIA_bot)
TELEGRAM_TOKEN=

# LLM — cadeia de provedores com fallback automático (ordem = prioridade).
# O 1º com key preenchida é o primário; se estourar rate limit, cai pro próximo.
LLM_PROVIDER=groq,gemini,openrouter
GROQ_API_KEY=            # https://console.groq.com/keys (grátis)
GEMINI_API_KEY=          # https://aistudio.google.com/apikey (grátis, free tier generoso)
OPENROUTER_API_KEY=      # https://openrouter.ai/keys (alternativa)
LLM_MODEL=               # opcional, sobrescreve o modelo só do 1º provedor
LLM_CONCURRENCY=2        # chamadas simultâneas por provedor (free tier: 2)

# Banco (Postgres) — bot e web usam o mesmo
DATABASE_URL=postgresql://arist:arist_local_dev@127.0.0.1:5432/aristotelia

# Painel web
WEB_URL=http://localhost:3000

# chat_id do Telegram da Fernanda — vira superadmin no /start
SUPERADMIN_CHAT_ID=

TZ=America/Sao_Paulo
