# Copie para .env e preencha. NUNCA commite o .env.

# Token do BotFather (t.me/AristotelIA_bot)
TELEGRAM_TOKEN=

# Provedor do LLM: groq | openrouter
LLM_PROVIDER=groq

# Chave gratuita — https://console.groq.com/keys
GROQ_API_KEY=

# Chave gratuita (alternativa) — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Opcional: sobrescreve o modelo padrão do provedor
LLM_MODEL=

TZ=America/Sao_Paulo
